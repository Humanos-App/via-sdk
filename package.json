{
  "name": "@humanos/via-sdk-v03",
  "version": "0.4.1",
  "description": "VIA Protocol SDK — create and verify VIA mandates, DIDs, actions, events, and presentations. Implements via-protocol-spec v0.3 (Ed25519 / eddsa-jcs-2022 / W3C VC 2.0).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Humanos",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./action/cel": {
      "types": "./dist/action/cel.d.ts",
      "import": "./dist/action/cel.js",
      "require": "./dist/action/cel.cjs"
    },
    "./agent/sim": {
      "types": "./dist/agent/sim.d.ts",
      "import": "./dist/agent/sim.js",
      "require": "./dist/agent/sim.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "platform-drift": "node scripts/platform-drift.mjs",
    "pretest": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "@sd-jwt/core": "^0.22.0",
    "@sd-jwt/sd-jwt-vc": "^0.22.0",
    "cbor-x": "^1.6.6",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@peculiar/x509": "^1.14.3",
    "@types/node": "^25.9.9",
    "canonicalize": "^5.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
